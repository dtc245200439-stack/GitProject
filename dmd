-- ============================================================
-- AUTORIDE OPTIMIZED DATABASE
-- Data Architect: [Học viên]
-- Mô tả: Nâng cấp CSDL khắc phục Data Gaps từ Legacy Script
-- ============================================================

DROP DATABASE IF EXISTS autoride_db;
CREATE DATABASE autoride_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE autoride_db;

-- ============================================================
-- PHẦN 1: DDL - ĐỊNH NGHĨA CẤU TRÚC
-- ============================================================

-- 1.1. Bảng Cars (giữ nguyên, bổ sung daily_rate)
CREATE TABLE Cars (
    car_id INT AUTO_INCREMENT PRIMARY KEY,
    model_name VARCHAR(100) NOT NULL,
    license_plate VARCHAR(20) UNIQUE NOT NULL,
    daily_rate DECIMAL(12,2) NOT NULL DEFAULT 0
);

-- 1.2. Bảng Rentals (nâng cấp toàn diện)
CREATE TABLE Rentals (
    rental_id INT AUTO_INCREMENT PRIMARY KEY,
    car_id INT NOT NULL,
    customer_name VARCHAR(100) NOT NULL,
    rent_date DATETIME NOT NULL,
    return_date DATETIME NULL,
    
    -- FIX LỖI 1: ENUM khóa chặt vòng đời hợp đồng
    status ENUM('BOOKED', 'ACTIVE', 'COMPLETED', 'CANCELLED') 
           NOT NULL DEFAULT 'BOOKED',
    
    -- FIX LỖI 2: Bổ sung các cột tài chính với DECIMAL(12,2)
    security_deposit DECIMAL(12,2) NOT NULL DEFAULT 0,
    late_fee         DECIMAL(12,2) NOT NULL DEFAULT 0,
    damage_fee       DECIMAL(12,2) NOT NULL DEFAULT 0,
    
    -- Cột tính toán tự động: Tiền hoàn lại
    refund_amount DECIMAL(12,2) 
        GENERATED ALWAYS AS (security_deposit - late_fee - damage_fee) STORED,
    
    -- Ràng buộc toàn vẹn
    CONSTRAINT fk_rental_car FOREIGN KEY (car_id) 
        REFERENCES Cars(car_id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT chk_dates CHECK (return_date IS NULL OR return_date >= rent_date),
    CONSTRAINT chk_money CHECK (
        security_deposit >= 0 AND late_fee >= 0 AND damage_fee >= 0
    ),
    CONSTRAINT chk_refund CHECK (
        security_deposit - late_fee - damage_fee >= 0
    )
);

-- 1.3. Bảng Inspections (MỚI - FIX LỖI 3)
CREATE TABLE Inspections (
    inspection_id INT AUTO_INCREMENT PRIMARY KEY,
    rental_id INT NOT NULL,
    inspection_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    damage_description TEXT,
    inspector_name VARCHAR(100) NOT NULL,
    damage_fee DECIMAL(12,2) NOT NULL DEFAULT 0,
    
    CONSTRAINT fk_inspection_rental FOREIGN KEY (rental_id) 
        REFERENCES Rentals(rental_id) ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT chk_inspection_fee CHECK (damage_fee >= 0)
);

-- 1.4. Index tối ưu truy vấn
CREATE INDEX idx_rentals_status ON Rentals(status);
CREATE INDEX idx_rentals_car ON Rentals(car_id);
CREATE INDEX idx_inspections_rental ON Inspections(rental_id);

-- ============================================================
-- PHẦN 2: DML - MÔ PHỎNG KỊCH BẢN NGHIỆP VỤ
-- ============================================================

-- 2.1. Thêm xe vào hệ thống
INSERT INTO Cars (model_name, license_plate, daily_rate) VALUES
('Toyota Vios 2023', '51A-12345', 800000),
('Honda CR-V 2022', '51B-67890', 1200000);

-- 2.2. KHÁCH "Nguyen Van A" ĐẶT XE, ĐÓNG CỌC 10.000.000
INSERT INTO Rentals 
    (car_id, customer_name, rent_date, status, security_deposit)
VALUES 
    (1, 'Nguyen Van A', '2024-03-01 08:00:00', 'BOOKED', 10000000);

-- 2.3. Khách NHẬN XE → chuyển ACTIVE
UPDATE Rentals 
SET status = 'ACTIVE' 
WHERE rental_id = 1;

-- 2.4. KHÁCH TRẢ XE (trễ 2 ngày, vỡ đèn pha)
-- Bước 4a: Ghi nhận biên bản kiểm tra
INSERT INTO Inspections 
    (rental_id, inspection_date, damage_description, inspector_name, damage_fee)
VALUES 
    (1, '2024-03-05 17:00:00', 'Vỡ đèn pha trái, xước cản trước', 'Tran Van B', 2000000);

-- Bước 4b: Cập nhật hợp đồng → COMPLETED với phí phạt
-- Giả sử phí trễ 2 ngày = 2 × 800.000 = 1.600.000 (theo daily_rate)
UPDATE Rentals 
SET 
    return_date = '2024-03-05 17:00:00',
    status = 'COMPLETED',
    late_fee = 1600000,
    damage_fee = 2000000
WHERE rental_id = 1;

-- ============================================================
-- PHẦN 3: TRUY VẤN NGHIỆP VỤ
-- ============================================================

-- 3.1. Tính số tiền thực tế cần hoàn trả cho khách
SELECT 
    r.rental_id,
    r.customer_name,
    r.security_deposit                AS Tien_Coc,
    r.late_fee                        AS Phat_Tre,
    r.damage_fee                      AS Phat_Hu_Hong,
    (r.security_deposit - r.late_fee - r.damage_fee) AS Tien_Hoan_Lai,
    r.refund_amount                   AS Tien_Hoan_Lai_Auto,
    r.status
FROM Rentals r
WHERE r.rental_id = 1;

-- 3.2. Xem chi tiết biên bản kiểm tra kèm hợp đồng
SELECT 
    r.rental_id,
    r.customer_name,
    i.inspection_date,
    i.inspector_name,
    i.damage_description,
    i.damage_fee
FROM Rentals r
JOIN Inspections i ON r.rental_id = i.rental_id
WHERE r.rental_id = 1;

-- 3.3. Báo cáo doanh thu phạt theo tháng
SELECT 
    DATE_FORMAT(return_date, '%Y-%m') AS Thang,
    COUNT(*) AS So_Hop_Dong,
    SUM(late_fee) AS Tong_Phat_Tre,
    SUM(damage_fee) AS Tong_Phat_Hu_Hong,
    SUM(late_fee + damage_fee) AS Tong_Thu_Nhap_Phat
FROM Rentals
WHERE status = 'COMPLETED'
GROUP BY DATE_FORMAT(return_date, '%Y-%m');
